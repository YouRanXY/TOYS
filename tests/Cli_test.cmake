if(NOT DEFINED APP OR NOT DEFINED FIXTURE OR NOT DEFINED BUILD_ROOT OR NOT DEFINED PREPARE_DB)
    message(FATAL_ERROR "APP, FIXTURE, BUILD_ROOT and PREPARE_DB are required")
endif()
get_filename_component(fixtureAbsolute "${FIXTURE}" ABSOLUTE)
get_filename_component(fixtureParent "${fixtureAbsolute}" DIRECTORY)
get_filename_component(buildAbsolute "${BUILD_ROOT}" ABSOLUTE)
get_filename_component(fixtureName "${fixtureAbsolute}" NAME)
if(NOT fixtureParent STREQUAL buildAbsolute OR NOT fixtureName MATCHES "^fixture-cli-")
    message(FATAL_ERROR "Fixture must be a dedicated child of the build directory")
endif()
if(EXISTS "${FIXTURE}")
    message(FATAL_ERROR "Fixture already exists: ${FIXTURE}")
endif()
file(MAKE_DIRECTORY "${FIXTURE}/input/nested")
file(WRITE "${FIXTURE}/input/hello.TXT" "hello")
file(WRITE "${FIXTURE}/input/picture.JPG" "picture")
file(WRITE "${FIXTURE}/input/unknown.bin" "unknown")
file(WRITE "${FIXTURE}/input/nested/child.txt" "nested")
set(db "${FIXTURE}/index.db")

function(run expected)
    execute_process(COMMAND "${APP}" ${ARGN}
        WORKING_DIRECTORY "${FIXTURE}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "Command ${ARGN}: exit ${code}, expected ${expected}\n${output}\n${error}")
    endif()
    set(result "${output}" PARENT_SCOPE)
    set(diagnostic "${error}" PARENT_SCOPE)
endfunction()

run(0 --help)
run(0)
if(EXISTS "${FIXTURE}/filemanager.db")
    message(FATAL_ERROR "Help must not create a database")
endif()
run(0 organize "${FIXTURE}/input" --db "${db}")
if(NOT EXISTS "${FIXTURE}/input/hello.TXT" OR EXISTS "${FIXTURE}/input/Text" OR EXISTS "${db}")
    message(FATAL_ERROR "Preview must have no filesystem side effects")
endif()
run(1 organize "${FIXTURE}/missing" --apply --db "${db}")
run(1 organize "${FIXTURE}/input" --apply --db "${FIXTURE}/missing/db")
if(NOT EXISTS "${FIXTURE}/input/hello.TXT")
    message(FATAL_ERROR "Database open failure must prevent movement")
endif()
run(0 scan "${FIXTURE}/input" --db "${db}")
run(0 query --db "${db}")
if(NOT result MATCHES "Records: 3")
    message(FATAL_ERROR "Scan must index only top-level files: ${result}")
endif()
run(0 query --db "${db}" --category Text --extension TXT --name hello)
if(NOT result MATCHES "Records: 1" OR NOT result MATCHES "hello.TXT")
    message(FATAL_ERROR "Combined filters must find the expected file")
endif()
run(0 query --db "${db}" --name "' OR 1=1 --")
if(NOT result MATCHES "Records: 0")
    message(FATAL_ERROR "Literal filters must not become SQL")
endif()
run(0 organize "${FIXTURE}/input" --apply --db "${db}")
if(EXISTS "${FIXTURE}/input/hello.TXT" OR NOT EXISTS "${FIXTURE}/input/Text/hello.TXT"
    OR NOT EXISTS "${FIXTURE}/input/Images/picture.JPG"
    OR NOT EXISTS "${FIXTURE}/input/unknown.bin" OR NOT EXISTS "${FIXTURE}/input/nested/child.txt")
    message(FATAL_ERROR "Apply must move recognized files and retain unknown/nested files")
endif()
run(0 query --db "${db}" --category Text)
if(NOT result MATCHES "Text/hello.TXT")
    message(FATAL_ERROR "Index must reflect the actual moved destination: ${result}")
endif()
file(WRITE "${FIXTURE}/input/hello.TXT" "new source")
run(1 organize "${FIXTURE}/input" --apply --db "${db}")
file(READ "${FIXTURE}/input/hello.TXT" source)
file(READ "${FIXTURE}/input/Text/hello.TXT" destination)
if(NOT source STREQUAL "new source" OR NOT destination STREQUAL "hello")
    message(FATAL_ERROR "Collisions must preserve both contents")
endif()

# Even when its suffix is recognized, never move or index the active database.
set(activeDb "${FIXTURE}/input/active.txt")
run(0 scan "${FIXTURE}/input" --db "${activeDb}")
run(0 query --db "${activeDb}")
if(NOT result MATCHES "Records: 2" OR result MATCHES "active.txt")
    message(FATAL_ERROR "Active database must be excluded from its own index")
endif()
run(1 organize "${FIXTURE}/input" --apply --db "${activeDb}")
if(NOT EXISTS "${activeDb}" OR EXISTS "${FIXTURE}/input/Text/active.txt")
    message(FATAL_ERROR "Active database must never be moved")
endif()

run(1 query --db "${FIXTURE}/absent.db")
if(EXISTS "${FIXTURE}/absent.db")
    message(FATAL_ERROR "Query must not create missing databases")
endif()
run(1 scan "${FIXTURE}/input" --apply)
run(1 organize "${FIXTURE}/input" --category Text)
run(1 query --extension)
run(1 query --db "${db}" --category Invalid)
run(1 organize "${FIXTURE}/input" --db "${db}" --db "${db}")
run(1 unknown)

file(MAKE_DIRECTORY "${FIXTURE}/empty")
run(0 scan "${FIXTURE}/empty" --db "${db}")
run(0 query --db "${db}" --category Images)
if(NOT result MATCHES "Records: 0")
    message(FATAL_ERROR "Root refresh should remove stale images, retaining other roots")
endif()

# Exercise wide Windows arguments and UTF-8 query output with actual movement.
file(MAKE_DIRECTORY "${FIXTURE}/中文目录")
file(WRITE "${FIXTURE}/中文目录/笔记.TXT" "unicode contents")
run(0 organize "${FIXTURE}/中文目录" --apply --db "${FIXTURE}/中文索引.db")
if(NOT EXISTS "${FIXTURE}/中文目录/Text/笔记.TXT")
    message(FATAL_ERROR "Unicode CLI arguments must reach the filesystem correctly")
endif()
run(0 query --db "${FIXTURE}/中文索引.db" --name "笔记")
if(NOT result MATCHES "Records: 1" OR NOT result MATCHES "Text/笔记.TXT")
    message(FATAL_ERROR "Unicode names and destinations must survive CLI indexing")
endif()

if(WIN32)
    file(MAKE_DIRECTORY "${FIXTURE}/junction-root" "${FIXTURE}/junction-target")
    file(WRITE "${FIXTURE}/junction-root/main.cpp" "retained")
    file(TO_NATIVE_PATH "${FIXTURE}/junction-root/Code" junction)
    file(TO_NATIVE_PATH "${FIXTURE}/junction-target" junctionTarget)
    execute_process(COMMAND cmd /c mklink /J "${junction}" "${junctionTarget}"
        RESULT_VARIABLE junctionCode OUTPUT_VARIABLE junctionOutput ERROR_VARIABLE junctionError)
    if(NOT junctionCode EQUAL 0)
        message(FATAL_ERROR "Cannot prepare junction test: ${junctionOutput}\n${junctionError}")
    endif()
    run(1 organize "${FIXTURE}/junction-root" --apply --db "${db}")
    if(NOT EXISTS "${FIXTURE}/junction-root/main.cpp"
        OR EXISTS "${FIXTURE}/junction-target/main.cpp")
        message(FATAL_ERROR "Category junction must not redirect movement")
    endif()
    # Remove the junction alone, before recursively cleaning fixture contents.
    execute_process(COMMAND cmd /c rmdir "${junction}" RESULT_VARIABLE removeJunctionCode)
    if(NOT removeJunctionCode EQUAL 0)
        message(FATAL_ERROR "Cannot remove test junction safely")
    endif()
endif()

file(MAKE_DIRECTORY "${FIXTURE}/postfailure")
file(WRITE "${FIXTURE}/postfailure/fail.txt" "keep this data")
execute_process(COMMAND "${PREPARE_DB}" "postfailure.db"
    WORKING_DIRECTORY "${FIXTURE}" RESULT_VARIABLE preparationCode)
if(NOT preparationCode EQUAL 0)
    message(FATAL_ERROR "Cannot prepare post-move database failure")
endif()
run(1 organize "${FIXTURE}/postfailure" --apply --db "${FIXTURE}/postfailure.db")
if(EXISTS "${FIXTURE}/postfailure/fail.txt" OR NOT EXISTS "${FIXTURE}/postfailure/Text/fail.txt")
    message(FATAL_ERROR "Database failure after movement must not destroy moved data")
endif()
if(NOT diagnostic MATCHES "index refresh failed" OR NOT diagnostic MATCHES "category directories")
    message(FATAL_ERROR "Failure must explain partial state and nonrecursive recovery: ${diagnostic}")
endif()
run(0 query --db "${FIXTURE}/postfailure.db")
if(NOT result MATCHES "postfailure/fail.txt" OR result MATCHES "Text/fail.txt")
    message(FATAL_ERROR "Failed post-move refresh should retain the original snapshot")
endif()

# FIXTURE is a CTest-generated child of the build directory, checked above.
file(REMOVE_RECURSE "${FIXTURE}")
